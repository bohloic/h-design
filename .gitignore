# ============================================
# H-Designer Frontend — .gitignore
# Optimisé pour un déploiement de production léger
# ============================================

# Dépendances
node_modules/
.pnpm-store/

# Livrables & Builds de production
dist/
dist-ssr/
build/
out/
.next/
.vercel/

# Caches d'outillage & compilateurs
.vite/
.turbo/
.parcel-cache/
.eslintcache/
*.tsbuildinfo

# Environnements & Secrets confidentiels
.env
.env.*
!.env.example
!.env.template

# Logs & Traces de débogage
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Rapports de couverture & Tests
coverage/
.nyc_output/

# Fichiers temporaires & Backups
tmp/
temp/
.temp/
*.tmp
*.temp
*~
*.bak

# Fichiers Système d'Exploitation (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs & Éditeurs de code
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
